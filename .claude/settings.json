{
  "permissions": {
    "allow": [
      "Bash(ollama list *)",
      "Bash(brew list *)",
      "Bash(sysctl -n *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_clean.sh"
          }
        ]
      }
    ]
  }
}
